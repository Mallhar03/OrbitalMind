venv/
__pycache__/
*.pyc
*.pyo
.DS_Store
data/raw/
models/saved/
outputs/
*.pt
*.ckpt
# Keep outputs structure but ignore content
outputs/*.csv
outputs/*.png
outputs/*.txt
!outputs/.gitkeep

# Claude Flow per-session state (machine-local, not project source)
.claude-flow/

# Local-only 10-day working plan — never push this
plan/

# Result directories from comparison runs — regenerable, and large
outputs_*/

# Session working aids: run supervisors, watchdogs, progress indicators and
# resume helpers. Useful while driving a long run, not part of the project.
scripts/_*.sh
scripts/progress.py
scripts/statusline.sh
scripts/finalise.sh
scripts/resume_work.sh
scripts/compare_options.py
CHECKPOINT.md

# Stage audit records. Kept locally as the working history of how each stage was
# verified; the conclusions that matter live in README.md, memory/decisions.md
# and .claude/audit/DECK-CORRECTIONS.md.
memory/ppt_audit/

# Audit machinery — the process that produced the findings. Only the actionable
# output (.claude/audit/DECK-CORRECTIONS.md) is tracked.
.claude/audit/archive/
.claude/audit/AUDIT_CONTRACT.md
.claude/audit/PPT_CLAIMS.md
.claude/audit/STAGES.md
.claude/audit/S1-TO-S2-HANDOFF.md
.claude/audit/S2-TO-S3-HANDOFF.md
.claude/audit/S3-TO-S4-HANDOFF.md

# Editor/tooling state
.claude/settings.json
.claude/agents/
.claude/commands/

# Backups
*.bak-*
